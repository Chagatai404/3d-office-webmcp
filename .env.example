# Copy to .env.local and use values from `npx supabase status -o env` locally.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-key

# Absolute origin used to build shareable invitation links. Falls back to the
# proxy-forwarded host, then to the request URL.
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000

# Local-only secret key, used by tests/domain to age or revoke an invitation
# row directly. No application code reads it, and the suite falls back to
# `supabase status`, so this is only needed when the CLI is not on PATH.
# SUPABASE_SECRET_KEY=replace-with-local-secret-key

# Enables the deliberately isolated early-phase transition route for /room/demo.
# Never enable this escape hatch for non-demo rooms.
ALLOW_DEMO_PHASE_TRANSITIONS=false

# Enables transactional reset/reseed of the single shared /room/demo room.
# Keep disabled outside a controlled demonstration environment.
ALLOW_DEMO_RESET=false
